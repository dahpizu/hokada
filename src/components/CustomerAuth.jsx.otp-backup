import { useEffect, useState } from "react";
import {
  ArrowRight,
  Bike,
  Lock,
  Mail,
  Phone,
  User,
  ShieldCheck,
} from "lucide-react";
import { supabase } from "../lib/supabase";

export default function CustomerAuth({ onAuthenticated }) {
  const [mode, setMode] = useState("login");
  const [fullName, setFullName] = useState("");
  const [phone, setPhone] = useState("");
  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");
  const [verificationCode, setVerificationCode] = useState("");
  const [loading, setLoading] = useState(false);
  const [resendCooldown, setResendCooldown] = useState(0);
  const [errorMessage, setErrorMessage] = useState("");
  const [successMessage, setSuccessMessage] = useState("");

  useEffect(() => {
    let mounted = true;

    async function checkSession() {
      if (!supabase) return;

      const {
        data: { session },
        error,
      } = await supabase.auth.getSession();

      if (!error && session?.user && mounted) {
        onAuthenticated(session.user);
      }
    }

    checkSession();

    return () => {
      mounted = false;
    };
  }, [onAuthenticated]);

  useEffect(() => {
    if (resendCooldown <= 0) return undefined;

    const timer = setTimeout(() => {
      setResendCooldown((seconds) => Math.max(0, seconds - 1));
    }, 1000);

    return () => clearTimeout(timer);
  }, [resendCooldown]);

  function switchMode(nextMode) {
    setMode(nextMode);
    setErrorMessage("");
    setSuccessMessage("");
    setVerificationCode("");
  }

  async function handleSubmit(event) {
    event.preventDefault();

    if (!supabase) {
      setErrorMessage("HOKADA could not connect to Supabase. Please try again.");
      return;
    }

    setErrorMessage("");
    setSuccessMessage("");

    const normalizedEmail = email.trim().toLowerCase();

    if (!normalizedEmail) {
      setErrorMessage("Please enter your email address.");
      return;
    }

    if (mode === "signup") {
      if (!fullName.trim() || !phone.trim()) {
        setErrorMessage("Please enter your full name and phone number.");
        return;
      }

      if (password.length < 6) {
        setErrorMessage("Password must be at least 6 characters.");
        return;
      }
    }

    if (mode === "login" && !password) {
      setErrorMessage("Please enter your password.");
      return;
    }

    if (mode === "verify") {
      if (!/^\d{6}$/.test(verificationCode.trim())) {
        setErrorMessage("Enter the six-digit code sent to your email.");
        return;
      }

      try {
        setLoading(true);

        const { data, error } = await supabase.auth.verifyOtp({
          email: normalizedEmail,
          token: verificationCode.trim(),
          type: "signup",
        });

        if (error) throw error;

        if (!data.user) {
          throw new Error(
            "Email verification could not be completed. Please try again."
          );
        }

        const { error: profileError } = await supabase
          .from("customer_profiles")
          .upsert(
            {
              id: data.user.id,
              full_name: fullName.trim(),
              phone: phone.trim(),
              updated_at: new Date().toISOString(),
            },
            { onConflict: "id" }
          );

        if (profileError) {
          console.error("Customer profile save failed:", profileError);
          setSuccessMessage(
            "Your email is verified, but your profile could not be saved. Please log in or contact support if the problem continues."
          );
          setMode("login");
          setPassword("");
          return;
        }

        setSuccessMessage("Email verified. Welcome to HOKADA!");
        onAuthenticated(data.user);
      } catch (error) {
        console.error("Email verification error:", error);
        setErrorMessage(
          error?.message ||
            "That code could not be verified. Check it and try again."
        );
      } finally {
        setLoading(false);
      }

      return;
    }

    try {
      setLoading(true);

      if (mode === "signup") {
        const { data, error } = await supabase.auth.signUp({
          email: normalizedEmail,
          password,
          options: {
            data: {
              full_name: fullName.trim(),
              phone: phone.trim(),
            },
          },
        });

        if (error) throw error;

        if (!data.user) {
          throw new Error("Account could not be created. Please try again.");
        }

        if (data.session) {
          await supabase.auth.signOut();
          throw new Error(
            "Email confirmation is not enabled in Supabase. Please enable email confirmations before allowing new registrations."
          );
        }

        setEmail(normalizedEmail);
        setVerificationCode("");
        setResendCooldown(60);
        setMode("verify");
        setSuccessMessage(
          "We've sent a verification code to your email. Enter the six-digit code below to finish creating your account."
        );
        return;
      }

      const { data, error } = await supabase.auth.signInWithPassword({
        email: normalizedEmail,
        password,
      });

      if (error) throw error;

      if (!data.user) {
        throw new Error("Login failed. Please try again.");
      }

      if (!data.user.email_confirmed_at) {
        await supabase.auth.signOut();
        setMode("verify");
        setSuccessMessage(
          "Please verify your email before logging in. Enter the code sent to your email."
        );
        return;
      }

      onAuthenticated(data.user);
    } catch (error) {
      console.error("Customer authentication error:", error);

      setErrorMessage(
        error?.message || "Authentication failed. Please try again."
      );
    } finally {
      setLoading(false);
    }
  }

  async function handleResendCode() {
    if (!supabase || loading || resendCooldown > 0) return;

    setErrorMessage("");
    setSuccessMessage("");

    try {
      setLoading(true);

      const { error } = await supabase.auth.resend({
        type: "signup",
        email: email.trim().toLowerCase(),
      });

      if (error) throw error;

      setResendCooldown(60);
      setVerificationCode("");
      setSuccessMessage("A new verification code has been sent to your email.");
    } catch (error) {
      console.error("Resend verification code error:", error);
      setErrorMessage(
        error?.message ||
          "We couldn't resend the code. Please wait a moment and try again."
      );
    } finally {
      setLoading(false);
    }
  }

  function returnToLogin() {
    setMode("login");
    setVerificationCode("");
    setPassword("");
    setErrorMessage("");
    setSuccessMessage("");
  }

  return (
    <div className="app-shell auth-shell">
      <main className="auth-page">
        <div className="auth-brand">
          <div className="brand-icon">
            <Bike size={26} />
          </div>

          <div className="brand-text">
            <span>HOKADA</span>
            <small>FAST. SAFE. DELIVERED.</small>
          </div>
        </div>

        <section className="auth-card">
          <div className="auth-card-header">
            <span className="eyebrow">
              {mode === "login"
                ? "WELCOME BACK"
                : mode === "signup"
                ? "JOIN HOKADA"
                : "EMAIL VERIFICATION"}
            </span>

            <h1>
              {mode === "login"
                ? "Welcome back."
                : mode === "signup"
                ? "Create your account."
                : "Verify your email."}
            </h1>

            <p>
              {mode === "login"
                ? "Log in to book riders and track your deliveries."
                : mode === "signup"
                ? "Create your HOKADA account to manage your deliveries."
                : `Enter the six-digit code sent to ${email}.`}
            </p>
          </div>

          {errorMessage && (
            <div className="auth-message error" role="alert">
              {errorMessage}
            </div>
          )}

          {successMessage && (
            <div className="auth-message success" role="status">
              {successMessage}
            </div>
          )}

          {mode === "verify" ? (
            <form onSubmit={handleSubmit} className="auth-form">
              <div className="form-section">
                <label htmlFor="verification-code">Six-digit code</label>

                <div className="input-with-icon">
                  <ShieldCheck size={19} />

                  <input
                    id="verification-code"
                    type="text"
                    inputMode="numeric"
                    autoComplete="one-time-code"
                    value={verificationCode}
                    onChange={(event) =>
                      setVerificationCode(
                        event.target.value.replace(/\D/g, "").slice(0, 6)
                      )
                    }
                    placeholder="000000"
                    maxLength={6}
                    required
                    autoFocus
                    aria-describedby="verification-help"
                  />
                </div>

                <small id="verification-help">
                  Check your inbox and spam folder. The code may expire.
                </small>
              </div>

              <button
                type="submit"
                className="primary-button full-width auth-submit"
                disabled={loading || verificationCode.length !== 6}
              >
                {loading ? "Verifying..." : "Verify email"}
                <ArrowRight size={19} />
              </button>

              <button
                type="button"
                className="primary-button full-width"
                onClick={handleResendCode}
                disabled={loading || resendCooldown > 0}
              >
                {resendCooldown > 0
                  ? `Resend code in ${resendCooldown}s`
                  : "Resend verification code"}
              </button>

              <button
                type="button"
                className="auth-text-button"
                onClick={returnToLogin}
                disabled={loading}
              >
                Back to login
              </button>
            </form>
          ) : (
            <form onSubmit={handleSubmit} className="auth-form">
              {mode === "signup" && (
                <>
                  <div className="form-section">
                    <label htmlFor="full-name">Full name</label>

                    <div className="input-with-icon">
                      <User size={19} />
                      <input
                        id="full-name"
                        type="text"
                        value={fullName}
                        onChange={(event) => setFullName(event.target.value)}
                        placeholder="Your full name"
                        autoComplete="name"
                        required
                      />
                    </div>
                  </div>

                  <div className="form-section">
                    <label htmlFor="phone">Phone number</label>

                    <div className="input-with-icon">
                      <Phone size={19} />
                      <input
                        id="phone"
                        type="tel"
                        value={phone}
                        onChange={(event) => setPhone(event.target.value)}
                        placeholder="080..."
                        autoComplete="tel"
                        required
                      />
                    </div>
                  </div>
                </>
              )}

              <div className="form-section">
                <label htmlFor="email">Email address</label>

                <div className="input-with-icon">
                  <Mail size={19} />
                  <input
                    id="email"
                    type="email"
                    value={email}
                    onChange={(event) => setEmail(event.target.value)}
                    placeholder="you@example.com"
                    autoComplete="email"
                    required
                  />
                </div>
              </div>

              <div className="form-section">
                <label htmlFor="password">Password</label>

                <div className="input-with-icon">
                  <Lock size={19} />
                  <input
                    id="password"
                    type="password"
                    value={password}
                    onChange={(event) => setPassword(event.target.value)}
                    placeholder="At least 6 characters"
                    autoComplete={
                      mode === "login" ? "current-password" : "new-password"
                    }
                    minLength={6}
                    required
                  />
                </div>
              </div>

              <button
                type="submit"
                className="primary-button full-width auth-submit"
                disabled={loading}
              >
                {loading
                  ? "Please wait..."
                  : mode === "login"
                  ? "Log in"
                  : "Create account"}
                <ArrowRight size={19} />
              </button>
            </form>
          )}

          {mode !== "verify" && (
            <div className="auth-switch">
              <span>
                {mode === "login"
                  ? "Don't have a HOKADA account?"
                  : "Already have a HOKADA account?"}
              </span>

              <button
                type="button"
                onClick={() => switchMode(mode === "login" ? "signup" : "login")}
                disabled={loading}
              >
                {mode === "login" ? "Create account" : "Log in"}
              </button>
            </div>
          )}
        </section>
      </main>
    </div>
  );
}
